// prisma/schema.prisma
// Same schema as original finpay-api — unchanged
// All services share this single schema (one RDS database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account?
  auditLogs AuditLog[]

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  userId       String        @unique
  balance      Int           @default(0)   // stored in cents — same as original
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentTxns     Transaction[] @relation("SenderAccount")
  receivedTxns Transaction[] @relation("ReceiverAccount")

  @@map("accounts")
}

model Transaction {
  id              String   @id @default(uuid())
  senderId        String
  receiverId      String
  amount          Int      // in cents
  description     String?
  status          String   @default("COMPLETED")
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  sender          Account  @relation("SenderAccount",   fields: [senderId],   references: [id])
  receiver        Account  @relation("ReceiverAccount", fields: [receiverId], references: [id])

  @@map("transactions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  meta      String?
  ipAddress String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
